# Environment template for Shyam Akaash / user-management-app
#
# Backend reads:  backend/.env   (copy the Backend section there)
# Frontend build: project-root .env.production  (CRA loads REACT_APP_* / PUBLIC_URL on `npm run build`)
#
# --- Production clone (/var/www/user-management-app) ---
#   APP_BASE_PATH=/shyam_akaash
#   PORT=5000
#   BASE_URL=https://4thstate.ca/shyam_akaash
#
# --- Staging / dev clone (separate folder + branch) ---
#   APP_BASE_PATH=/shyam_akaash_dev
#   PORT=5001
#   BASE_URL=https://4thstate.ca/shyam_akaash_dev
#   UPLOAD_DIR=.../backend/uploads   # keep separate from production
#   DATABASE_URL=./users.db          # keep separate from production
#   Then build with matching frontend vars (see Frontend section below).

# =============================================================================
# Backend → copy to backend/.env
# =============================================================================

# JWT Secret Key — required in production (32+ random characters).
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Listen port (production 5000, staging/dev clone 5001 — must not collide)
PORT=5000
NODE_ENV=development

# URL path the app is served under (no trailing slash).
# nginx + React basename + Express mounts must all use this same value.
# Production: /shyam_akaash
# Staging:    /shyam_akaash_dev
APP_BASE_PATH=/shyam_akaash

# Public site origin + path (no trailing slash). Used for RSS, share OG, Stripe return, emails.
# Production: https://4thstate.ca/shyam_akaash
# Staging:    https://4thstate.ca/shyam_akaash_dev
BASE_URL=https://4thstate.ca/shyam_akaash

# Browser origin(s) allowed to call the API (comma-separated). Include the real site origin.
# Production: https://4thstate.ca
# Local CRA:  http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Optional explicit frontend origin for password-reset links (defaults to CORS_ORIGIN / BASE_URL logic)
# FRONTEND_URL=https://4thstate.ca

# SQLite database file (use a different path/file on staging so you do not share prod data)
DATABASE_URL=./users.db

# Absolute path for uploaded audio/images. Defaults to backend/uploads if unset.
# Production and staging clones should use different directories.
# UPLOAD_DIR=/var/www/user-management-app/backend/uploads

# Security
BCRYPT_ROUNDS=10

# Bootstrap scripts only (never commit real values). Required when running:
#   node create-admin.js            → ADMIN_PASSWORD
#   node create-test-subscriber.js  → TEST_PASSWORD
# ADMIN_PASSWORD=
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@4thstate.ca
# TEST_PASSWORD=
# TEST_USERNAME=testmember
# TEST_EMAIL=test@4thstate.ca

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Podcast membership platform
# ---------------------------------------------------------------------------

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Official recurring Price ID from Stripe Dashboard (Product catalog).
# Checkout bills every paying subscriber with this Price. Can also be set via
# platform_settings.stripe_price_id (admin settings API).
STRIPE_PRICE_ID=

# Fallback display / MRR amount when Stripe Price cannot be retrieved
DEFAULT_SUBSCRIPTION_PRICE=9.99

# Optional podcast channel metadata for the generated RSS feeds
PODCAST_TITLE=Shyam Akaash
PODCAST_AUTHOR=Shyam Akaash
PODCAST_EMAIL=podcast@4thstate.ca
# PODCAST_DESCRIPTION=Members-only audio from Shyam Akaash.
# Channel artwork for RSS/podcast apps (default: public/podcast-cover.jpg)
# PODCAST_COVER_FILE=podcast-cover.jpg
# PODCAST_IMAGE_URL=https://4thstate.ca/shyam_akaash/uploads/images/podcast-artwork.jpg
# PODCAST_CATEGORY=Religion & Spirituality

# =============================================================================
# Frontend build (CRA) → copy matching lines to .env.production in the project root
# =============================================================================
# These are baked in at `npm run build`. They must match APP_BASE_PATH / BASE_URL above.
#
# Production build:
#   PUBLIC_URL=/shyam_akaash
#   REACT_APP_BASE_PATH=/shyam_akaash
#
# Staging build:
#   PUBLIC_URL=/shyam_akaash_dev
#   REACT_APP_BASE_PATH=/shyam_akaash_dev
#
# Or one-shot:
#   PUBLIC_URL=/shyam_akaash_dev REACT_APP_BASE_PATH=/shyam_akaash_dev npm run build
#
PUBLIC_URL=/shyam_akaash
REACT_APP_BASE_PATH=/shyam_akaash

# Optional: override API origin for local `npm start` (default http://localhost:5000)
# REACT_APP_API_ORIGIN=http://localhost:5000
